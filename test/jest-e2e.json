{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/modules/**/**/*.ts",
    "!src/modules/**/**/*.spec.ts"
  ],
  "coverageDirectory": "./coverage/e2e",
  "coverageReporters": ["text", "lcov", "html"]
}

